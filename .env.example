# Proposed configuration contract. No runtime exists in the planning baseline.
# Never put real credentials or customer data in this public repository.
# SB-02 must implement config validation; blank required values must fail closed.
APP_ENV=local
NODE_ENV=development
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
AUTOMATION_MODE=OFF
CHANNEL_MODE=mock
CRM_MODE=mock
LLM_MODE=mock

# Runtime role must NOT be owner/superuser/BYPASSRLS.
DATABASE_URL=
# Separate migration job only; not loaded by request/worker runtime.
MIGRATION_DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Select operator auth provider and validate issuer/audience server-side.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_SESSION_SECRET=
DATA_ENCRYPTION_KEY_REFERENCE=

# Real provider settings must be selected and verified before non-mock operation.
LLM_PROVIDER=
LLM_MODEL_ID=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSION=
EMBEDDING_API_KEY=

# Single-binding local/staging bootstrap only.
# Multi-tenant production bindings use per-account encrypted secret references.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_OA_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_CALLBACK_URL=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# No guessed rate cards, endpoint versions or monetary-action permissions.
CHANNEL_POLICY_CONFIG_PATH=
APPROVED_RATE_CARD_PATH=
MONTHLY_SPEND_CAP=
SPEND_CURRENCY=
ENABLE_ORDER_CHANGE_EXECUTION=false
ENABLE_MONETARY_EXECUTION=false
ENABLE_IDENTITY_LINKING=false
ENABLE_PROACTIVE_FOLLOWUP=false

# Initial tuning proposals, not provider limits or achieved SLOs.
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_DRAFT_ATTEMPTS=2
AGENT_MAX_FALLBACKS=1
KNOWLEDGE_CONTEXT_TOKEN_BUDGET=4000
MEMORY_CONTEXT_TOKEN_BUDGET=1000
LOG_RAW_MESSAGES=false
LOG_RAW_PROMPTS=false
OTEL_EXPORTER_OTLP_ENDPOINT=
