# v3 PROPOSED application configuration; runtime is not implemented yet.
# Public repo: placeholders only. SB-02 must validate settings and fail closed.
APP_ENV=local
NODE_ENV=development
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
AUTOMATION_MODE=OFF
CHANNEL_MODE=mock
CRM_MODE=mock
LLM_MODE=mock
ZALO_PERSONAL_ENABLED=false
WHATSAPP_ENABLED=false
ZALO_CONNECTION_MODE=manual
WHATSAPP_ACCOUNT_TYPE_CONFIRMED=false
AUTO_PUBLISH_KNOWLEDGE=false
ENABLE_ORDER_CHANGE_EXECUTION=false
ENABLE_MONETARY_EXECUTION=false
ENABLE_IDENTITY_LINKING=false
ENABLE_PROACTIVE_FOLLOWUP=false
ENABLE_SCHEDULED_REPORTS=false

# Least-privilege runtime DB; separate migration process only for admin credential.
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
DATA_ENCRYPTION_KEY_REFERENCE=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_SESSION_SECRET=

# No real vault/session/QR/customer data inside the repository.
BRAIN_WORKSPACE_ROOT=
BRAIN_PUBLISHED_STORAGE_PREFIX=
ZALO_SESSION_SECRET_REFERENCE=
ZALO_SPOOL_PATH=
BRIDGE_SERVICE_CREDENTIAL_REFERENCE=
BRIDGE_BINDING_ID=
BRIDGE_PRIVATE_INGEST_URL=
# Dynamic lease epoch/session generation are server-issued, not .env constants.

WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
