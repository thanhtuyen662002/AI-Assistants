# Planning config contract only; runtime is not implemented.
# No real credentials, personal session, QR or customer data in public Git.
APP_ENV=local
NODE_ENV=development
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
AUTOMATION_MODE=OFF
CHANNEL_MODE=mock
CRM_MODE=mock
LLM_MODE=mock
DATABASE_URL=
# Migration job only; not loaded by runtime/bridge.
MIGRATION_DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_SESSION_SECRET=
DATA_ENCRYPTION_KEY_REFERENCE=
LLM_PROVIDER=
LLM_MODEL_ID=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSION=
EMBEDDING_API_KEY=

# PERSONAL ZALO, NOT OA. No Zalo App/OA token or OA webhook configuration.
# zca-js is an unofficial candidate; pin/review/test through SB-27.
ZALO_PERSONAL_ENABLED=false
ZALO_PERSONAL_ADAPTER=zca-js
ZALO_PERSONAL_PINNED_VERSION=
ZALO_PERSONAL_MODE=OFF
ZALO_PERSONAL_BINDING_ID=
# Server-side records must separately authorize owner/account-risk/live operation.
ZALO_PERSONAL_OWNER_AUTHORIZATION_REF=
ZALO_PERSONAL_RISK_REVIEW_REF=
ZALO_PERSONAL_SESSION_KEY_REFERENCE=
ZALO_PERSONAL_SESSION_STORE_PATH=
ZALO_PERSONAL_SPOOL_PATH=
ZALO_PERSONAL_SPOOL_MAX_BYTES=
ZALO_PERSONAL_SPOOL_RETENTION_HOURS=
ZALO_PERSONAL_ALLOWED_CONVERSATIONS_CONFIG=
ZALO_PERSONAL_QR_TTL_SECONDS=
ZALO_PERSONAL_MAX_SENDS_PER_MINUTE=
ZALO_PERSONAL_MAX_SENDS_PER_DAY=
ZALO_PERSONAL_ENABLE_GROUPS=false
ZALO_PERSONAL_ENABLE_PROACTIVE_SEND=false
# Private API, per-binding credential references, raw-body auth and fencing.
ZALO_BRIDGE_INTERNAL_API_URL=
ZALO_BRIDGE_SERVICE_CREDENTIAL_REF=
ZALO_BRIDGE_LEASE_TTL_SECONDS=
ZALO_BRIDGE_HEARTBEAT_INTERVAL_SECONDS=
# Limits above are required app budgets, NOT guarantees against account restrictions.

# WhatsApp remains the official Cloud API assumption, not WhatsApp Web.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
CHANNEL_POLICY_CONFIG_PATH=
APPROVED_RATE_CARD_PATH=
MONTHLY_SPEND_CAP=
SPEND_CURRENCY=
ENABLE_ORDER_CHANGE_EXECUTION=false
ENABLE_MONETARY_EXECUTION=false
ENABLE_IDENTITY_LINKING=false
ENABLE_PROACTIVE_FOLLOWUP=false
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_DRAFT_ATTEMPTS=2
AGENT_MAX_FALLBACKS=1
KNOWLEDGE_CONTEXT_TOKEN_BUDGET=4000
MEMORY_CONTEXT_TOKEN_BUDGET=1000
LOG_RAW_MESSAGES=false
LOG_RAW_PROMPTS=false
OTEL_EXPORTER_OTLP_ENDPOINT=
